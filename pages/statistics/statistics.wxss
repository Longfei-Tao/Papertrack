.page {
  padding: 24rpx;
}
.page-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1B2233;
  padding: 8rpx 8rpx 24rpx;
}
.stat-grid {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -8rpx 16rpx;
}
.stat-cell {
  width: 33.33%;
  padding: 8rpx;
  box-sizing: border-box;
}
.section {
  background: #FFFFFF;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(27, 34, 51, 0.05);
  padding: 8rpx 28rpx 24rpx;
  margin-bottom: 24rpx;
}
.section-title {
  padding: 24rpx 0 12rpx;
  font-size: 24rpx;
  color: #98A1B0;
  font-weight: 500;
}
.bar-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
}
.bar-label {
  width: 160rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: #667080;
}
.bar-label.name {
  width: 160rpx;
  color: #1B2233;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  margin-right: 10rpx;
  flex-shrink: 0;
}
.bar-track {
  flex: 1;
  height: 16rpx;
  background: #F0F2F5;
  border-radius: 8rpx;
  overflow: hidden;
  margin: 0 16rpx;
}
.bar-fill {
  height: 100%;
  border-radius: 8rpx;
}
.bar-fill.member {
  background: #3563A6;
}
.bar-count {
  width: 48rpx;
  text-align: right;
  font-size: 26rpx;
  font-weight: 600;
  color: #1B2233;
  flex-shrink: 0;
}
.empty {
  padding: 24rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #98A1B0;
}
