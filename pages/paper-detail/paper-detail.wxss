.page {
  padding: 24rpx;
  padding-bottom: 48rpx;
}
.head {
  background: #FFFFFF;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(27, 34, 51, 0.05);
  padding: 32rpx 28rpx;
  margin-bottom: 24rpx;
}
.title {
  font-size: 36rpx;
  font-weight: 600;
  color: #1B2233;
  line-height: 1.45;
}
.head-row {
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}
.raw-status {
  margin-left: 16rpx;
  font-size: 26rpx;
  color: #667080;
}
.deadline-hint {
  margin-top: 16rpx;
  display: inline-block;
  font-size: 24rpx;
  color: #C08A3E;
  background: #FBF4E8;
  border-radius: 6rpx;
  padding: 6rpx 16rpx;
}

.section {
  background: #FFFFFF;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(27, 34, 51, 0.05);
  padding: 8rpx 28rpx;
  margin-bottom: 24rpx;
}
.section-title {
  padding: 24rpx 0 8rpx;
  font-size: 24rpx;
  color: #98A1B0;
  font-weight: 500;
}
.row {
  display: flex;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #F0F2F5;
}
.row.no-border { border-bottom: none; }
.k {
  width: 200rpx;
  flex-shrink: 0;
  color: #98A1B0;
  font-size: 28rpx;
}
.v {
  flex: 1;
  color: #1B2233;
  font-size: 28rpx;
  line-height: 1.5;
  word-break: break-all;
}
.note {
  padding: 20rpx 0 28rpx;
  border-top: 1rpx solid #F0F2F5;
  margin-top: 8rpx;
}
.note-label {
  font-size: 24rpx;
  color: #98A1B0;
  margin-bottom: 8rpx;
}
.note-text {
  font-size: 28rpx;
  color: #667080;
  line-height: 1.6;
}
.no-history {
  padding: 24rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #98A1B0;
}
.actions {
  margin-top: 8rpx;
}
.delete {
  margin-top: 24rpx;
}
