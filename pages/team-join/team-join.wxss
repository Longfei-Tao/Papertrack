.page {
  padding: 24rpx;
}
.search {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 12rpx rgba(27, 34, 51, 0.05);
  padding: 16rpx 16rpx 16rpx 28rpx;
}
.code-input {
  flex: 1;
  font-size: 32rpx;
  color: #1B2233;
  letter-spacing: 2rpx;
}
.ph { color: #98A1B0; letter-spacing: 0; }
.search-btn {
  flex-shrink: 0;
}
.card {
  margin-top: 32rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(27, 34, 51, 0.05);
  overflow: hidden;
  padding: 0 28rpx;
}
.q {
  padding: 28rpx 0;
  font-size: 32rpx;
  font-weight: 600;
  color: #1B2233;
  border-bottom: 1rpx solid #F0F2F5;
}
.row {
  display: flex;
  align-items: center;
  padding: 26rpx 0;
  border-bottom: 1rpx solid #F0F2F5;
}
.row.no-border { border-bottom: none; }
.k {
  width: 160rpx;
  color: #98A1B0;
  font-size: 28rpx;
}
.v {
  flex: 1;
  color: #1B2233;
  font-size: 28rpx;
}
.join-btn {
  margin-top: 32rpx;
}
.hint {
  margin-top: 24rpx;
  text-align: center;
  font-size: 24rpx;
  color: #98A1B0;
}
