page {
  background: #F6F7F9;
}
.welcome {
  height: 100vh;
  display: flex;
  flex-direction: column;
  padding: 0 48rpx;
  box-sizing: border-box;
}
.hero {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.mark {
  position: relative;
  width: 140rpx;
  height: 140rpx;
  border-radius: 32rpx;
  background: #3563A6;
  display: flex;
  align-items: center;
  justify-content: center;
}
.sheet {
  width: 56rpx;
  height: 70rpx;
  background: #FFFFFF;
  border-radius: 8rpx;
}
.dot {
  position: absolute;
  right: -8rpx;
  top: -8rpx;
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  background: #4A7BB8;
  border: 6rpx solid #F6F7F9;
}
.brand {
  margin-top: 32rpx;
  font-size: 48rpx;
  font-weight: 700;
  color: #1B2233;
  letter-spacing: 1rpx;
}
.slogan {
  margin-top: 16rpx;
  font-size: 28rpx;
  color: #667080;
}
.actions {
  padding-bottom: 120rpx;
}
.join {
  margin-top: 24rpx;
}
.hint {
  margin-top: 32rpx;
  text-align: center;
  font-size: 24rpx;
  color: #98A1B0;
}
