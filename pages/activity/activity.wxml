<view class="page">
  <view class="page-title">{{teamName}}</view>
  <view class="section">
    <view wx:for="{{items}}" wx:key="id" class="item" hover-class="pt-hover" data-paper-id="{{item.paperId}}" bindtap="onItemTap">
      <member-avatar name="{{item.userName}}" size="{{64}}" />
      <view class="body">
        <view class="line1">
          <text class="user">{{item.userName}}</text>
          <text class="action">{{item.actionText}}</text>
        </view>
        <view class="paper pt-ellipsis">{{item.paperTitle}}</view>
        <view class="time">{{item.timeText}}</view>
      </view>
      <view class="arrow"></view>
    </view>
    <empty-state wx:if="{{!items.length}}" title="暂无动态" desc="论文状态发生变化时会在这里记录。" />
  </view>
</view>
