.form {
  padding: 24rpx 24rpx 0;
}
.section {
  background: #FFFFFF;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(27, 34, 51, 0.05);
  margin-bottom: 24rpx;
  overflow: hidden;
}
.section-title {
  padding: 24rpx 28rpx 8rpx;
  font-size: 24rpx;
  color: #98A1B0;
  font-weight: 500;
}
.row {
  display: flex;
  align-items: center;
  padding: 26rpx 28rpx;
  border-bottom: 1rpx solid #F0F2F5;
  min-height: 60rpx;
}
.row.no-border { border-bottom: none; }
.block {
  padding: 20rpx 28rpx 24rpx;
  border-bottom: 1rpx solid #F0F2F5;
}
.block.no-border { border-bottom: none; }
.field-label {
  font-size: 30rpx;
  color: #1B2233;
  flex-shrink: 0;
}
.row .field-label { width: 200rpx; }
.field-label.required::after {
  content: ' *';
  color: #B5584E;
}
.field-value {
  flex: 1;
  text-align: right;
  color: #1B2233;
  font-size: 30rpx;
}
.field-value.placeholder { color: #98A1B0; }
.arrow {
  width: 14rpx;
  height: 14rpx;
  border-top: 2rpx solid #98A1B0;
  border-right: 2rpx solid #98A1B0;
  transform: rotate(45deg);
  margin-left: 12rpx;
  flex-shrink: 0;
}
.text-input {
  width: 100%;
  margin-top: 12rpx;
  font-size: 30rpx;
  color: #1B2233;
  min-height: 48rpx;
  line-height: 1.5;
}
.row-input {
  flex: 1;
  text-align: right;
  font-size: 30rpx;
  color: #1B2233;
}
.ph { color: #98A1B0; }

/* 作者 chip */
.chips {
  margin-top: 12rpx;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
}
.chip-item {
  display: flex;
  align-items: center;
  background: #EDF2FA;
  color: #3563A6;
  font-size: 26rpx;
  border-radius: 8rpx;
  padding: 8rpx 12rpx;
  margin: 0 12rpx 12rpx 0;
}
.chip-x {
  margin-left: 8rpx;
  color: #98A1B0;
  font-size: 30rpx;
  line-height: 1;
  padding: 0 4rpx;
}
.chip-input {
  flex: 1;
  min-width: 220rpx;
  font-size: 26rpx;
  color: #1B2233;
  margin-bottom: 12rpx;
  height: 48rpx;
}

/* 负责人多选 */
.member-chips {
  margin-top: 12rpx;
  display: flex;
  flex-wrap: wrap;
}
.member-chip {
  font-size: 26rpx;
  color: #667080;
  background: #F6F7F9;
  border: 1rpx solid #EAEDF1;
  border-radius: 999rpx;
  padding: 10rpx 28rpx;
  margin: 0 16rpx 16rpx 0;
}
.member-chip.selected {
  color: #3563A6;
  background: #EDF2FA;
  border-color: #3563A6;
}
.empty-hint {
  font-size: 26rpx;
  color: #98A1B0;
  padding: 8rpx 0;
}

/* 常用状态建议 */
.suggestions {
  margin-top: 16rpx;
  display: flex;
  flex-wrap: wrap;
}
.suggest {
  font-size: 22rpx;
  color: #667080;
  background: #F6F7F9;
  border-radius: 6rpx;
  padding: 6rpx 16rpx;
  margin: 0 12rpx 12rpx 0;
}
.suggest.active {
  color: #3563A6;
  background: #EDF2FA;
}
.revision-hint {
  padding: 16rpx 28rpx;
  font-size: 24rpx;
  color: #C08A3E;
  background: #FBF4E8;
  border-bottom: 1rpx solid #F0F2F5;
}

/* 备注 */
.textarea {
  width: 100%;
  min-height: 160rpx;
  padding: 16rpx 28rpx 24rpx;
  box-sizing: border-box;
  font-size: 30rpx;
  color: #1B2233;
  line-height: 1.6;
}

.submit {
  margin-top: 8rpx;
}
.safe {
  height: 40rpx;
}
