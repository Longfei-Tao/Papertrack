.stat-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(27, 34, 51, 0.05);
  padding: 24rpx 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.stat-card.active {
  background: #EDF2FA;
}
.stat-card.pressed {
  opacity: 0.72;
}
.num {
  font-size: 40rpx;
  font-weight: 600;
  color: #1B2233;
  line-height: 1.2;
}
.stat-card.active .num { color: #3563A6; }
.label {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #667080;
}
